# 复制为 .env 后填入你自己的 Key（.env 已被 .gitignore 忽略，不会进版本库）
# 执行者与评审者可以分别配置不同的服务商，实现真正的跨模型对抗。

# 小米 MiMo（当前默认：执行者 mimo-v2.6-flash / 评审者 mimo-v2.6-pro）
XIAOMI_API_KEY=tp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：第二家模型当评审者（拿到额度后启用，并把 configs/default.yaml 里 models.reviewer.provider 改掉）
# DEEPSEEK_API_KEY=
# MODELSCOPE_API_KEY=
# SILICONFLOW_API_KEY=
